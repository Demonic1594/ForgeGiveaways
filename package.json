{
  "name": "@tryforge/reforge.giveaways",
  "version": "2.3.0",
  "description": "ReForgeGiveaways: a reworked giveaway extension for ForgeScript with no duration limit, crash and downtime recovery, abuse protection, pause/resume, bonus entries, requirements and customizable messages. Fork of tryforge/ForgeGiveaways.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "docgen": "tsc && node dist/docgen",
    "docs": "tsc && typedoc src/index.ts",
    "commit": "npm run docgen && node dist/commit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Demonic1594/ReForgeGiveaways.git"
  },
  "keywords": [
    "discord",
    "extension",
    "forge",
    "forgescript",
    "giveaway",
    "giveaways",
    "reforge",
    "reforgegiveaways"
  ],
  "author": "itsnicky. (original), Demonic1594 (fork)",
  "license": "GPL-3.0",
  "devDependencies": {
    "@tryforge/forge.db": "^2.1.1",
    "@tryforge/forgescript": "^2.7.1",
    "@tryforge/reforge.db": "github:Demonic1594/ReForgeDB#v3.1.0",
    "@types/node": "^22.20.5",
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.27.0",
    "typedoc": "^0.26.11",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "tiny-typed-emitter": "^2.1.0",
    "typeorm": "^0.3.31"
  },
  "peerDependencies": {
    "@tryforge/forgescript": ">=2.5.0",
    "@tryforge/reforge.db": "^3.0.0",
    "@tryforge/forge.db": "^2.1.0",
    "discord.js": "^14.25.0"
  },
  "peerDependenciesMeta": {
    "@tryforge/reforge.db": {
      "optional": true
    },
    "@tryforge/forge.db": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "metadata",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "bugs": {
    "url": "https://github.com/Demonic1594/ReForgeGiveaways/issues"
  },
  "homepage": "https://github.com/Demonic1594/ReForgeGiveaways#readme"
}
